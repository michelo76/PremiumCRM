      <property>
        <name>Debug Mode</name>
        <type>LIST</type>
        <items><item>Off</item><item>Print</item><item>Log</item><item>Print and Log</item></items>
        <default>Off</default>
        <readonly>false</readonly>
      </property>
    </properties>
    <actions>
      <action><name>Refresh Now</name><command>RefreshNow</command></action>
      <action><name>Clear Metadata Cache</name><command>ClearMetadataCache</command></action>
      <action><name>Print State</name><command>PrintState</command></action>
      <action><name>Print Room Media Info</name><command>PrintRoomMediaInfo</command></action>
