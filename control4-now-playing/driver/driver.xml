      <property>
        <name>Poll Interval Playing</name>
        <type>RANGED_INTEGER</type>
        <minimum>1</minimum>
        <maximum>30</maximum>
        <default>2</default>
        <readonly>false</readonly>
      </property>
      <property>
        <name>Poll Interval Idle</name>
        <type>RANGED_INTEGER</type>
        <minimum>2</minimum>
        <maximum>120</maximum>
