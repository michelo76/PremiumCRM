      <property><name>Apple TV Bridge URL</name><type>STRING</type><default></default><readonly>false</readonly></property>
      <property><name>Apple TV Device</name><type>STRING</type><default></default><readonly>false</readonly></property>
      <property><name>Apple TV Bridge Token</name><type>STRING</type><default></default><password>true</password><readonly>false</readonly></property>

