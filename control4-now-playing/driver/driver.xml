  <name>Now Playing Info</name>
  <model>Now Playing Info</model>
  <created>11/11/2026 12:00</created>
  <modified>11/11/2026 12:00</modified>
  <version>10000</version>
  <control>lua_gen</control>
  <controlmethod>IP</controlmethod>
  <driver>DriverWorks</driver>
  <combo>true</combo>
  <minimum_os_version>3.1.3</minimum_os_version>
  <small image_source="c4z">icons/device_sm.png</small>
  <large image_source="c4z">icons/device_lg.png</large>
  <proxies qty="1">
    <proxy proxybindingid="5001" name="Now Playing" image_source="c4z" small_image="icons/device_sm.png" large_image="icons/device_lg.png">uibutton</proxy>
  </proxies>
  <capabilities>
    <web_view_url proxybindingid="5001">controller://driver/now_playing_info/index.html</web_view_url>
    <mobile_web_view_enabled>true</mobile_web_view_enabled>
    <navigator_display_option proxybindingid="5001">
      <display_icons>
        <Icon width="70" height="70">controller://driver/now_playing_info/icons/np_70.png</Icon>
        <Icon width="90" height="90">controller://driver/now_playing_info/icons/np_90.png</Icon>
        <Icon width="300" height="300">controller://driver/now_playing_info/icons/np_300.png</Icon>
        <Icon width="512" height="512">controller://driver/now_playing_info/icons/np_512.png</Icon>
        <Icon width="1024" height="1024">controller://driver/now_playing_info/icons/np_1024.png</Icon>
        <state id="playing">
          <Icon width="70" height="70">controller://driver/now_playing_info/icons/np_playing_70.png</Icon>
          <Icon width="90" height="90">controller://driver/now_playing_info/icons/np_playing_90.png</Icon>
          <Icon width="300" height="300">controller://driver/now_playing_info/icons/np_playing_300.png</Icon>
          <Icon width="512" height="512">controller://driver/now_playing_info/icons/np_playing_512.png</Icon>
          <Icon width="1024" height="1024">controller://driver/now_playing_info/icons/np_playing_1024.png</Icon>
        </state>
      </display_icons>
    </navigator_display_option>
  </capabilities>
  <events>
    <event><id>1</id><name>Media Changed</name><description>When NAME media changes</description><sort_order>1</sort_order></event>
    <event><id>2</id><name>Playback Started</name><description>When NAME playback starts</description><sort_order>2</sort_order></event>
    <event><id>3</id><name>Playback Paused</name><description>When NAME playback is paused</description><sort_order>3</sort_order></event>
    <event><id>4</id><name>Playback Stopped</name><description>When NAME playback stops (stopped, idle or off after playing or paused)</description><sort_order>4</sort_order></event>
    <event><id>5</id><name>Playback Resumed</name><description>When NAME paused media resumes playing</description><sort_order>5</sort_order></event>
    <event><id>6</id><name>Details Available</name><description>When NAME metadata details (ratings, cast, overview) become available</description><sort_order>6</sort_order></event>
    <event><id>7</id><name>Source Changed</name><description>When NAME active source device changes</description><sort_order>7</sort_order></event>
    <event><id>8</id><name>App Changed</name><description>When NAME active app changes</description><sort_order>8</sort_order></event>
    <event><id>9</id><name>Movie Started</name><description>When a movie starts playing in NAME</description><sort_order>9</sort_order></event>
    <event><id>10</id><name>TV Episode Started</name><description>When a TV episode starts playing in NAME</description><sort_order>10</sort_order></event>
    <event><id>11</id><name>Music Track Started</name><description>When a music track starts playing in NAME</description><sort_order>11</sort_order></event>
    <event><id>12</id><name>Live TV Started</name><description>When live TV starts playing in NAME</description><sort_order>12</sort_order></event>
  </events>
  <connections>
    <connection>
      <id>5001</id>
      <facing>6</facing>
      <connectionname>UIBUTTON</connectionname>
      <type>2</type>
      <consumer>False</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>False</linelevel>
      <classes>
        <class>
          <classname>UIBUTTON</classname>
        </class>
      </classes>
    </connection>
  </connections>
