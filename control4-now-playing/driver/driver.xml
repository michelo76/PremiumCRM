      <property><name>Room Settings</name><type>LABEL</type><default>Room</default></property>
      <property>
        <name>Room</name>
        <type>DEVICE_SELECTOR</type>
        <items><item>roomdevice.c4i</item></items>
        <multiselect>false</multiselect>
        <default></default>
        <readonly>false</readonly>
      </property>
      <property>
        <name>Use Control4 Room Media</name>
        <type>LIST</type>
        <items><item>On</item><item>Off</item></items>
        <default>On</default>
        <readonly>false</readonly>
      </property>
      <property>
        <name>Show Only When Room Is On</name>
        <type>LIST</type>
        <items><item>Off</item><item>On</item></items>
        <default>Off</default>
        <readonly>false</readonly>
